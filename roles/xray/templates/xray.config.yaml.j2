{# =============================================================================
   templates/xray.config.yaml.j2
   Xray-specific behavioural configuration (separate from the JFrog Platform
   system.yaml).  Controls indexing, watches, and vulnerability DB syncing.
   Managed by Ansible – do not edit this file manually on the host.
   ============================================================================= #}
## ============================================================
## JFrog Xray – xray.config.yaml
## Host    : {{ inventory_hostname }}
## Version : {{ xray_version }}
## Managed : Ansible ({{ ansible_date_time.iso8601 }})
## ============================================================

xray:
  # ── General ──────────────────────────────────────────────────────────────────
  serviceId: "{{ xray_node_id | default(inventory_hostname | replace('.', '-')) }}"

  # ── Vulnerability database synchronisation ───────────────────────────────────
  # When true, Xray will periodically pull updated vulnerability data from
  # the JFrog security research team (data.xray.jfrog.io).
  dbSyncXray:
    enabled: {{ xray_enable_vuln_db_sync | lower }}
    # Sync interval in hours (0 = use default, currently ~24h)
    timeInterval: 0

  # ── Watches & Policies ───────────────────────────────────────────────────────
  # Controls whether Xray enforces configured Watches on indexed artifacts.
  watches:
    enabled: {{ xray_enable_watches | lower }}

  # ── Indexing ─────────────────────────────────────────────────────────────────
  indexing:
    # Maximum number of artifacts indexed in parallel per node.
    # Scale up on nodes with more CPU/RAM; scale down to reduce resource pressure.
    maxParallelIndexers: 2

    # Maximum archive depth Xray recurses into during indexing.
    # Higher values increase thoroughness but also resource consumption.
    archiveDepth: 5

  # ── JFrog Platform integration ───────────────────────────────────────────────
  jfrogPlatform:
    url: "{{ jfrog_platform_url }}"
    adminUser: "{{ jfrog_platform_admin_user }}"
    # Token is injected from Vault at deploy time; never hard-coded here.
    adminToken: "{{ jfrog_platform_admin_token }}"
