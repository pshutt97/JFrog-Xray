{# =============================================================================
   templates/system.yaml.j2
   JFrog Platform system.yaml – the primary configuration file consumed by
   both the JFrog installer/upgrader and the running Xray process.
   Managed by Ansible – do not edit this file manually on the host.
   ============================================================================= #}
## ============================================================
## JFrog Xray – system.yaml
## Host    : {{ inventory_hostname }}
## Version : {{ xray_version }}
## Managed : Ansible ({{ ansible_date_time.iso8601 }})
## ============================================================

shared:
  # ── JFrog Platform node identity ────────────────────────────────────────────
  node:
    id: "{{ xray_node_id | default(inventory_hostname | replace('.', '-')) }}"

  # ── Database ────────────────────────────────────────────────────────────────
  database:
    type: "{{ xray_db_type }}"
    driver: >-
      {% if xray_db_type == 'postgresql' %}org.postgresql.Driver
      {% elif xray_db_type == 'mysql' %}com.mysql.jdbc.Driver
      {% else %}org.postgresql.Driver{% endif %}
    url: >-
      {% if xray_db_type == 'postgresql' %}
      postgres://{{ xray_db_user }}:{{ xray_db_password }}@{{ xray_db_host }}:{{ xray_db_port }}/{{ xray_db_name }}?sslmode=disable
      {% endif %}
    username: "{{ xray_db_user }}"
    password: "{{ xray_db_password }}"

  # ── RabbitMQ (message broker) ────────────────────────────────────────────────
{% if xray_rabbitmq_bundled %}
  rabbitMq:
    # Bundled RabbitMQ – managed by the Xray process itself
    erlangCookie: "JFROG-XRAY-RABBIT-COOKIE"
    nodeName: "xray@localhost"
{% else %}
  rabbitMq:
    active:
      rabbitmq:
        url: "amqp://{{ xray_rabbitmq_user }}:{{ xray_rabbitmq_password }}@{{ xray_rabbitmq_host }}:{{ xray_rabbitmq_port }}/"
{% endif %}

  # ── JFrog Platform (Artifactory) join ────────────────────────────────────────
  jfrogUrl: "{{ jfrog_platform_url }}"

{% if xray_http_proxy %}
  # ── Proxy ───────────────────────────────────────────────────────────────────
  proxy:
    http: "{{ xray_http_proxy }}"
    https: "{{ xray_https_proxy }}"
    noProxy: "{{ xray_no_proxy }}"
{% endif %}

# ── Xray-specific section ─────────────────────────────────────────────────────
xray:
  # Port the Xray HTTP API listens on
  port: {{ xray_http_port }}

  # Router (Access) port – used internally by the JFrog Platform
  router:
    port: {{ xray_router_port }}

  # gRPC port – used for Artifactory ↔ Xray communication
  grpc:
    port: {{ xray_grpc_port }}

  # Installation and data directories (mirrors CLI flags for runtime awareness)
  installDir: "{{ xray_install_dir }}"
  dataDir:    "{{ xray_data_dir }}"
  logDir:     "{{ xray_log_dir }}"
